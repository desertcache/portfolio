# Local-only babel toolchain. app-v4.js is GENERATED from app-v4.jsx and IS
# committed (index.html loads it); the tooling that generates it is not.
# See DEV-NOTES.md.
node_modules/

# Untracked on purpose — DEV-NOTES invariant. Ignoring it here means a stray
# `git add -A` can no longer sweep it into a commit.
mockups/

# pytest/python bytecode from running scripts/test_ingest_digest.py locally.
__pycache__/
*.pyc

# Raw digests the hill-money-watch skill drops here before ingest renders them
# into blog/posts/. Intermediates only. The skill's publish step ends in
# `git add blog/`, and without this rule that sweeps an unstyled duplicate of
# every post onto the live site at blog/hill-money-watch-<date>.html.
blog/hill-money-watch-*.html
