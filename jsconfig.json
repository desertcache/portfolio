{
  // Type-checks js/ without a build step: the files stay plain JavaScript,
  // and JSDoc comments carry the types. Run `npm run check`.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["js/**/*.js"]
}
