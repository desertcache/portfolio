{
  "name": "desertcache-portfolio",
  "private": true,
  "description": "Tooling only. The site itself is static HTML/CSS/JS with no build step (except skincare.css). See DEV-NOTES.md.",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "tsc -p jsconfig.json",
    "build:skincare": "tailwindcss -c tailwind.skincare.config.js -i skincare.src.css -o skincare.css --minify",
    "build": "npm run build:skincare"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
